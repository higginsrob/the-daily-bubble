# Required for chat and article rerank unless OPENAI_HOST is set.
OPENAI_API_KEY=

# Optional. Default: gpt-4.1
# OPENAI_MODEL=gpt-4.1
# OPENAI_MODEL=gpt-4o-mini

# Optional. OpenAI-compatible endpoint (Ollama, LM Studio, vLLM, …).
# When set, chat/rerank go here instead of api.openai.com. Local servers
# do not need a real API key. OPENAI_MODEL must be a model the host serves.
# OPENAI_HOST=http://localhost:11434
# OPENAI_MODEL=llama3.2

# Optional. Tracing stays off unless LANGSMITH_API_KEY is set.
# LANGSMITH_API_KEY=
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=the-daily-bubble

# Optional override for the profile/cache directory (default: ~/.the-daily-bubble).
# DAILY_BUBBLE_HOME=
